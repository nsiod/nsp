# nsp runtime environment example
#
# Load with:
#   set -a; source .env.example; set +a
# or copy the keys you need into a local `.env`.

# --- config source ---
# Optional. Only the CLI/env layer can change the config file path.
NSP_CONFIG=/etc/nsp/nsp.toml

# --- listener ---
# Accepts either a port or a full socket address.
NSP_LISTEN=0.0.0.0:443
NSP_DOMAIN=proxy.example.com

# --- TLS ---
# Set to false for local development or when TLS is terminated upstream.
NSP_TLS=false
NSP_TLS_CERT=
NSP_TLS_KEY=

# --- ACME ---
NSP_ACME=false
NSP_ACME_EMAIL=ops@example.com
# Comma-separated list when set via env.
NSP_ACME_DOMAINS=proxy.example.com
NSP_ACME_PRODUCTION=false
NSP_ACME_CACHE=/work/acme

# --- storage ---
NSP_DB=/work/data/proxy.db
NSP_WORK_DIR=/work

# --- security ---
# Empty or unset disables data-at-rest encryption.
NSP_MASTER_KEY=
# Local development only. Never enable for public deployments.
NSP_ALLOW_INSECURE_NO_MASTER_KEY=false
# First-run admin password. Remove after persistent credentials are set.
NSP_ADMIN_PASSWORD=changeme
NSP_JWT_TTL=900
# Lockdown stance for the /api/* surface (purely a local operator
# decision — independent of the reverse-API control center):
#   enabled  - full read/write admin surface (default).
#   readonly - GET/HEAD/OPTIONS only; writes return 403. SPA still
#              loads.
#   disabled - the HTTP listener is NOT bound at all (the admin port
#              doesn't show up in `ss -lntp` / `nmap`).
# Caution: combined with a misconfigured control center, `disabled`
# can lock you out of the node.
NSP_API=enabled

# --- WireGuard ---
NSP_WG=false
NSP_WG_PORT=51820
NSP_WG_SUBNET=10.255.0.0/16
NSP_WG_INTERFACE=wg0
# Data-plane: kernel (default, in-kernel module via netlink — needs
# CAP_NET_ADMIN and the wireguard module loaded), userspace (bundled
# gotatun + TUN fallback), or auto (kernel with userspace fallback).
NSP_WG_BACKEND=kernel

# --- Shadowsocks ---
NSP_SS=false
NSP_SS_BIND=0.0.0.0
NSP_SS_PORT=4433
NSP_SS_DEBOUNCE_MS=500

# --- logging ---
NSP_LOG=info
NSP_JSON_LOGS=true

# --- metrics ---
NSP_METRICS=false
NSP_METRICS_TOKEN=
NSP_METRICS_REFRESH_MS=10000

# --- backups ---
NSP_BACKUP=true
NSP_BACKUP_INTERVAL_SECS=3600
NSP_BACKUP_DIR=/work/backups
NSP_BACKUP_RETENTION_DAYS=7

# --- control center (reverse API) ---
# When enabled, nsp periodically POSTs a self-report (cursor + content
# hashes + service running state) to the configured control center and
# reconciles the response into local DB + iptables. URL, NODE_ID, and
# TOKEN are required when NSP_CONTROL=true.
# Full protocol: docs/control-center.md
NSP_CONTROL=false
NSP_CONTROL_URL=https://control.example.com
NSP_CONTROL_TOKEN=
NSP_CONTROL_NODE_ID=node-001
NSP_CONTROL_INTERVAL_SECS=60
NSP_CONTROL_TIMEOUT_SECS=10
# Cadence of POST /status (independent of /config). Use a longer
# value to dial down telemetry traffic, or a shorter one for finer
# observability granularity. Defaults to NSP_CONTROL_INTERVAL_SECS.
NSP_CONTROL_STATUS_INTERVAL_SECS=60
# Conflict resolution for local resources (users + control-source
# iptables rules) absent from a Full snapshot. Applied uniformly:
#   keep  - additive merge (default): pre-seeded local resources stay.
#   prune - authoritative: delete local extras to match the snapshot.
# The server can always force a hard alignment with mode:"replace"
# in a single response, regardless of this setting.
NSP_CONTROL_CONFLICT_POLICY=keep
